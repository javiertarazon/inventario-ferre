# ==================== FRONTEND REACT + VITE ====================

name: ferreteria-frontend
private: true
version: 1.0.0
type: module

scripts:
  dev: vite
  build: vite build
  preview: vite preview
  lint: eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0

dependencies:
  react: ^18.2.0
  react-dom: ^18.2.0
  react-router-dom: ^6.21.0
  axios: ^1.6.5
