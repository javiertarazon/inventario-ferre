  recharts: ^2.10.3
  date-fns: ^3.2.0
  lucide-react: ^0.303.0
  react-to-print: ^2.15.1

devDependencies:
  '@types/react': ^18.2.45
  '@types/react-dom': ^18.2.18
  '@vitejs/plugin-react': ^4.2.1
  autoprefixer: ^10.4.16
  postcss: ^8.4.33
  tailwindcss: ^3.4.1
  vite: ^5.0.10
