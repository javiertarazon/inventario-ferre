# ====================================================================
# CONFIGURACIÓN DE ENTORNO - TEMPLATE SEGURO
# Copia a .env y personaliza los valores
# ====================================================================

# FLASK CORE
FLASK_ENV=development
FLASK_APP=wsgi.py
FLASK_DEBUG=0

# SECURITY - GENERA NUEVOS VALORES CON:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-a-strong-secret-key-min-32-chars
JWT_SECRET_KEY=generate-a-strong-jwt-key-min-32-chars

# DATABASE
DATABASE_URL=sqlite:///instance/inventario.db

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CACHE
CACHE_TYPE=simple
REDIS_URL=redis://localhost:6379/0

# RATE LIMITING
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URL=memory://

# FILE UPLOADS
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# BACKUP
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# PAGINATION
ITEMS_PER_PAGE=20

# GUNICORN (producción)
GUNICORN_WORKERS=2
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_ACCESS_LOG=logs/access.log
GUNICORN_ERROR_LOG=logs/error.log
GUNICORN_LOG_LEVEL=info

# EMAIL (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=

# ADMIN SETUP
ADMIN_PASSWORD=admin

# FEATURE FLAGS
ENABLE_API=1
ENABLE_WEBHOOKS=0
ENABLE_OFFLINE_MODE=0

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Backup Configuration
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Pagination
ITEMS_PER_PAGE=20

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@example.com

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# Security
# Set to True in production to enforce HTTPS
FORCE_HTTPS=False
